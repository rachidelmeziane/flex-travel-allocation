{
    "runql.ai.source": "githubCopilot",
    "runql.ai.extension": "",
    "runql.ai.apiProvider": "",
    "runql.ai.model": "gpt-4.1",
    "runql.ai.apiBaseUrl": "",
    "runql.ai.sendSchemaContext": true,
    "runql.ai.maxSchemaChars": 150000,
    // Force .py files into the normal text editor so Databricks notebook-serializer
    // extensions don't hijack them (which would hide the Jupyter "Run Cell" lenses).
    // Force .ipynb files into VS Code's built-in Jupyter notebook editor so the
    // local Python kernel can be selected instead of only the Databricks kernel.
    "workbench.editorAssociations": {
        "*.py": "default",
        "*.ipynb": "jupyter-notebook"
    },
    // Treat Databricks "# COMMAND ----------" markers (and standard "# %%") as
    // Interactive Window cells so "Run Cell" code lenses appear in the .py notebooks.
    "jupyter.interactiveWindow.cellMarker.codeRegex": "^(# COMMAND ----------|# %%)",
    "jupyter.interactiveWindow.cellMarker.default": "# COMMAND ----------",
    // Run cells from the project root so "conf" and the local data/ folder resolve.
    "jupyter.notebookFileRoot": "${workspaceFolder}/flex-travel-allocation",
    // Use the project venv (PySpark 3.5.1 on Python 3.11) as the kernel/interpreter.
    "python.defaultInterpreterPath": "${workspaceFolder}/flex-travel-allocation/.venv/Scripts/python.exe",
    // Load JAVA_HOME (for PySpark) into the kernel/terminal environment.
    "python.envFile": "${workspaceFolder}/.env"
}