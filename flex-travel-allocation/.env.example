# Local machine paths so the JVM/Spark can run on Windows.
# Copy this file to `.env` and adjust the paths for your machine.
# `.env` is gitignored; only this template is committed.

# JDK 17 install (Spark 3.5 requires Java 11 or 17).
JAVA_HOME=C:\Program Files\Zulu\zulu-17

# Hadoop dir containing bin\winutils.exe and bin\hadoop.dll (Windows-only, for Spark file writes).
HADOOP_HOME=C:\Users\<your-user>\hadoop
